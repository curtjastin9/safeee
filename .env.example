# Copy to .env and adjust if your MySQL isn't the XAMPP default (root / no password / localhost).
# config/database.php reads these via getenv(); on plain XAMPP you can usually leave this unused.
SAFETRADE_DB_HOST=127.0.0.1
SAFETRADE_DB_NAME=safetrade
SAFETRADE_DB_USER=root
SAFETRADE_DB_PASS=
SAFETRADE_DB_PORT=3306
SAFETRADE_ENV=development
